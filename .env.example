# Option 1: Email/Password login (recommended)
JANDI_EMAIL=your_email@example.com
JANDI_PASSWORD=your_password

# Option 2: Direct refresh token (fallback)
# JANDI_REFRESH_TOKEN=your_refresh_token_here

# Optional: Browser executable path (auto-detected if not set)
# Supported browsers: Chrome, Chromium, Edge, Brave
# PUPPETEER_EXECUTABLE_PATH=/path/to/chrome
